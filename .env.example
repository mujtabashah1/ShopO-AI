# Local MongoDB connection string
MONGO_URI=mongodb://localhost:27017/smartshop

# Generate a long, random secret for each environment. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret

# Server Port
PORT=5000

# Environment
NODE_ENV=development

# Python AI Service
PYTHON_AI_URL=http://localhost:8000
PYTHON_AI_ENABLED=true

# Optional image identification/verification provider
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Optional comma-separated browser origins allowed by the API
CLIENT_URL=http://localhost:3000

# Shared with the Python service; required when enabled in production.
PYTHON_AI_KEY=

# Optional trusted reverse-proxy IPs/subnets. Set only for your actual topology.
TRUST_PROXY=
